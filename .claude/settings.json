{
  "permissions": {
    "allow": [
      "Bash(python3 tools/pipeline.py:*)",
      "Bash(python3 tools/scores.py:*)",
      "Bash(python3 -m tools.harvester:*)",
      "Bash(scripts/harvest.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git tag:*)",
      "Bash(git rev-parse:*)",
      "WebSearch",
      "WebFetch",
      "Bash(scripts/harvest.sh start:*)",
      "Bash(mkdir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(sort:*)",
      "Bash(date:*)",
      "Bash(git ls-files:*)",
      "Bash(git fetch:*)",
      "Bash(python3 tools/site.py:*)",
      "Bash(python3 tools/brief.py:*)",
      "Bash(python3 tools/quant.py:*)",
      "Bash(python3 tools/coherence.py:*)",
      "Bash(python3 tools/registry_guard.py:*)",
      "Bash(python3 tools/autopilot.py:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git push:*)",
      "Bash(git push)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(./.env.*)",
      "Bash(gh:*)",
      "Bash(security:*)",
      "Bash(launchctl:*)",
      "Bash(osascript:*)",
      "Bash(git remote:*)",
      "Bash(git config:*)"
    ],
    "defaultMode": "acceptEdits"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Read|Grep|Edit|Write|MultiEdit|NotebookEdit|WebFetch|WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/tools/blindness_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
