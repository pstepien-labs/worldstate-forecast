# Copy to .env (never commit .env). All keys are free; sources that need a
# missing key are skipped, not failed. Registering for a key is the only
# "login" the project uses (CLAUDE.md rule 6.2).

# Recommended: an e-mail address put in the harvester's User-Agent so site
# operators can contact you instead of blocking you.
HARVEST_CONTACT=

# GIE AGSI+ gas storage (EU, PL, DE): register at https://agsi.gie.eu/ -> account -> API key
AGSI_API_KEY=

# US EIA open data (Brent spot, US crude stocks): https://www.eia.gov/opendata/register.php
EIA_API_KEY=

# NASA FIRMS fire detections (independent check of strikes on refineries/ports):
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Optional tuning
# HARVEST_DATA=data/harvest        where the local corpus lives (not committed)
# HARVEST_BACKFILL_DAYS=14         how far back GDELT and datasets reach on the first run
# HARVEST_MIN_DELAY=3              seconds between requests to the same host
# HARVEST_CA_BUNDLE=               path to a CA bundle if your network uses a TLS proxy
